[MASTER]
ignore-patterns=test_.*?\.py

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    too-many-locals,
    too-many-arguments,
    too-many-statements,
    too-many-branches,
    too-many-instance-attributes,
    too-few-public-methods,
    duplicate-code,
    line-too-long,
    C0321,
    R0801,
    W0640,
    W0622,
    C3001,
    R1705,
    R1710,
    R1714

[DESIGN]
max-args=8
max-locals=20
max-statements=100
max-branches=15
